    "jose": "6.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.2.0",
    "@types/supertest": "7.2.1",
    "supertest": "7.2.2",
    "tsx": "4.23.10",
    "typescript": "7.0.2",
    "vite": "^7.3.6",
    "vitest": "4.1.10"
  }
