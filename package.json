{
  "name": "az-oidc-mock",
  "version": "1.0.0",
  "description": "Azure-style multi-tenant OIDC mock server for local development and tests",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run"
  },
  "keywords": [
    "oidc",
    "oauth2",
    "azure",
    "mock"
  ],
  "author": "",
  "license": "MIT",
